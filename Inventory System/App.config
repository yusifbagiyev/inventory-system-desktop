<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
    </startup>
    <connectionStrings>
        <!-- Your own SQL Server database, with the tables from database/schema.sql -->
        <add name="InventoryDb" connectionString="Data Source=localhost;Initial Catalog=InventoryDb;Integrated Security=True" providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <!-- Replace the sample AES key for user passwords with your own of 16, 24 or 32 characters -->
        <add key="PasswordKey" value="CHANGE-ME-32-CHARACTER-SECRETKEY" />
    </appSettings>
</configuration>
