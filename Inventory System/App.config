<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
    </startup>
    <connectionStrings>
        <!-- Point this at your own SQL Server database (see database/schema.sql). -->
        <add name="InventoryDb" connectionString="Data Source=localhost;Initial Catalog=InventoryDb;Integrated Security=True" providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <!-- AES key used to encrypt user passwords: exactly 16, 24 or 32 characters. Change it. -->
        <add key="PasswordKey" value="CHANGE-ME-32-CHARACTER-SECRETKEY" />
    </appSettings>
</configuration>
